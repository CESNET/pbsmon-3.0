# PBS configuration
KEYTAB_USER=USER@META

# Prometheus credentials
PROMETHEUS_BASE_URL=https://direct-prometheus.brno.openstack.cloud.e-infra.cz
PROMETHEUS_API_ENDPOINT=/api/v1/query
PROMETHEUS_USERNAME=USER
PROMETHEUS_PASSWORD=PASWORD

# Accounting database credentials
ACCOUNTING_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Clusters users with the statistics role (group pbsmon-statistics) may see,
# 'username=cluster1,cluster2' entries separated by ';'. A statistics user
# without an entry has no access to statistics. Admins see all clusters,
# '*' gives a statistics user all clusters too (e.g. carol=*).
STATISTICS_USER_CLUSTERS=alice=adan,zia;bob=elwe;carol=*
# Organizations (names from org_names) they may select, same format. Without an
# entry a statistics user can only use "All organizations", '*' allows all of
# them, like for admins.
# A backslash escapes a separator in a name: '\,' comma, '\;' semicolon,
# '\=' equals sign, '\\' backslash. Keep the value in single quotes, so the
# backslashes are passed as they are.
STATISTICS_USER_ORGANIZATIONS='alice=CESNET,Masarykova univerzita;bob=Example\, a.s.;carol=*'

# OIDC credentials
OIDC_CLIENT_ID=CLIENT_ID
OIDC_CLIENT_SECRET=CLIENT_SECRET
OIDC_ISSUER=OIDC_ISSUER
OIDC_REDIRECT_URI=OIDC_REDIRECT_URI

# sessions secret
SESSION_SECRET="GENERATE_ME_IDEALLY_LONG"

# FRONTEND_URL
FRONTEND_URL=https://HOSTNAME

# Septik job files S3 storage
SEPTIK_S3_ENDPOINT=https://S3_HOST
SEPTIK_S3_BUCKET=meta-septik
SEPTIK_S3_ACCESS_KEY=ACCESS_KEY
SEPTIK_S3_SECRET_KEY=SECRET_KEY
