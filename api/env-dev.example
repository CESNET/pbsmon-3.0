# OpenStack Prometheus login
PROMETHEUS_BASE_URL=https://dummy
PROMETHEUS_API_ENDPOINT=/api/v1/query
PROMETHEUS_USERNAME=user
PROMETHEUS_PASSWORD=pass

# Septik job files S3 storage (optional)
SEPTIK_S3_ENDPOINT=https://S3_HOST
SEPTIK_S3_BUCKET=meta-septik
SEPTIK_S3_ACCESS_KEY=ACCESS_KEY
SEPTIK_S3_SECRET_KEY=SECRET_KEY
